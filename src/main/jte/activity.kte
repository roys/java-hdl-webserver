@import com.roysolberg.java.hdlserver.ActivityLog
@import com.roysolberg.java.hdlserver.Page
@param page: Page
@param entries: List<ActivityLog.Entry>
@template.layout(page = page, content = @`
<div class="page-header">
    <h1 class="title">Activity</h1>
    <span class="tag is-rounded live-tag" title="This page updates by itself">Live</span>
</div>
<p class="subtitle is-6 has-text-grey">The latest ${ActivityLog.MAX_ENTRIES} actions run or refused, from IFTTT, the API and these pages, newest first.
    The list starts empty when the server starts.</p>
<div data-live="/activity/events">
    @template.live.activity(entries = entries)
</div>
`)
