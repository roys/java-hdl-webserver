@import com.roysolberg.java.hdlserver.HdlServer
@import com.roysolberg.java.hdlserver.HdlServer.AppPortProblem
@import com.roysolberg.java.hdlserver.Page
@import com.roysolberg.java.hdlserver.Pairing
@import com.roysolberg.java.hdlserver.Phones
@import com.roysolberg.java.hdlserver.Status
@param page: Page
@param checkForUpdates: Boolean = false
@param appPortOn: Boolean = false
@param appPort: Int = 0
@param appFingerprint: String? = null
@param appPortProblem: AppPortProblem? = null
@param pairingWindow: Pairing.Window? = null
@param phones: List<Phones.Phone> = emptyList()
@template.layout(page = page, content = @`
<h1 class="title">Settings</h1>
<div class="box">
    <form action="update_settings" method="post">
        <div class="field">
            <label class="label" for="input_auth_key">Authorization key</label>
            <div class="control">
                <input type="text" name="authKey" class="input is-family-monospace" id="input_auth_key" placeholder="At least ${HdlServer.MIN_AUTH_TOKEN_LENGTH} characters" minlength="${HdlServer.MIN_AUTH_TOKEN_LENGTH}" aria-describedby="help_auth_key" value="${page.authToken}"/>
            </div>
            <p id="help_auth_key" class="help">The key every action call needs. If you change it, also change it in your IFTTT applets and anything else calling this server.</p>
        </div>
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="checkForUpdates" aria-describedby="help_updates" checked="${checkForUpdates}">
                Check for updates
            </label>
            <p id="help_updates" class="help">Once a day, asks GitHub for the latest version, and shows it on the Status page when there's a newer one.
                GitHub sees this server's IP address when it does.</p>
        </div>
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="appPortOn" aria-describedby="help_app_port" checked="${appPortOn}">
                Let the Android app connect
            </label>
            <p id="help_app_port" class="help">Opens port ${appPort} for Smart Home for HDL Buspro, the Android app, with HTTPS
                and only from your home network or VPN.</p>
            @if(appPortProblem == AppPortProblem.PORT_TAKEN)
                <p class="help is-danger">Couldn't open port ${appPort}. Is something else using it? The log says more.</p>
            @elseif(appPortProblem == AppPortProblem.DATABASE_NOT_PRIVATE)
                <p class="help is-danger">Port ${appPort} stays closed: ${HdlServer.DATABASE_FILE} must be readable by its owner only,
                    since the port's private key would be kept there. Busbridge can't make it so on Windows yet, or when
                    another account owns the file.</p>
            @elseif(appFingerprint != null)
                <p class="help">Port ${appPort} is open. Its certificate's fingerprint, which the app checks:
                    <code class="fingerprint">${appFingerprint}</code></p>
            @endif
        </div>
        <button type="submit" class="button is-primary">Save</button>
    </form>
</div>
@if(appFingerprint != null)
<div class="box">
    <h2 class="title is-5">Connect a phone</h2>
    @if(pairingWindow == null)
        <p class="block">Pairs Smart Home for HDL Buspro with Busbridge. Do it at home, with the phone on the home network.</p>
        <form action="open_pairing" method="post">
            <button type="submit" class="button is-primary">Connect a phone</button>
        </form>
    @else
        <p class="block">Open until ${Status.formatTime(pairingWindow.closesAt).substring(11)}. In the app, tap Connect to Busbridge, and type the
            code it shows here.</p>
        @if(pairingWindow.phones.isEmpty())
            <p class="block has-text-grey">No phone has asked yet. Reload the page once the app shows a code.</p>
        @else
            <ul class="block">
                @for(phone in pairingWindow.phones)
                    <li>A phone calling itself “${phone}”</li>
                @endfor
            </ul>
        @endif
        <form action="pair_phone" method="post" class="block">
            <div class="field">
                <label class="label" for="input_pairing_code">Code shown in the app</label>
                <div class="control">
                    <input type="text" name="code" class="input is-family-monospace" id="input_pairing_code" inputmode="numeric" autocomplete="off" maxlength="7" required aria-describedby="help_pairing_code"/>
                </div>
                <p id="help_pairing_code" class="help">The name is only what the phone calls itself; the code is what shows it's your phone.</p>
            </div>
            <button type="submit" class="button is-primary">Allow</button>
        </form>
        <form action="cancel_pairing" method="post">
            <button type="submit" class="button">Cancel</button>
        </form>
    @endif
</div>
@endif
@if(phones.isNotEmpty())
<div class="box">
    <h2 class="title is-5">Paired phones</h2>
    <p class="block">These phones can reach the bus through Busbridge, also away from home over your VPN.</p>
    <div class="table-container">
        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>Name</th>
                <th>Paired</th>
                <th>Last seen</th>
                <th><span class="is-sr-only">Remove</span></th>
            </tr>
            </thead>
            <tbody>
            @for(phone in phones)
                <tr>
                    <td>${phone.name}</td>
                    <td>${Status.formatTime(phone.pairedAt)}</td>
                    <td>@if(phone.lastSeen != null)${Status.formatTime(phone.lastSeen)}@endif</td>
                    <td>
                        <form action="remove_phone" method="post">
                            <input type="hidden" name="phoneId" value="${phone.id}"/>
                            <button type="submit" class="button is-danger is-small">Remove</button>
                        </form>
                    </td>
                </tr>
            @endfor
            </tbody>
        </table>
    </div>
</div>
@endif
`)
