@import com.roysolberg.java.hdlserver.HdlServer
@import com.roysolberg.java.hdlserver.HdlServer.AppPortProblem
@import com.roysolberg.java.hdlserver.Page
@import com.roysolberg.java.hdlserver.PairingView
@import com.roysolberg.java.hdlserver.Phones
@param page: Page
@param checkForUpdates: Boolean = false
@param appPortOn: Boolean = false
@param appPort: Int = 0
@param appFingerprint: String? = null
@param appPortProblem: AppPortProblem? = null
@param pairingOpen: Boolean = false
@param pairingView: PairingView? = null
@param connecting: List<String> = emptyList()
@param phones: List<Phones.Phone> = emptyList()
@param connected: Set<String> = emptySet()
@template.layout(page = page, content = @`
<h1 class="title">Settings</h1>
<div class="box">
    <form action="update_settings" method="post">
        <div class="field">
            <label class="label" for="input_auth_key">Authorization key</label>
            <div class="control">
                <input type="text" name="authKey" class="input is-family-monospace" id="input_auth_key" placeholder="At least ${HdlServer.MIN_AUTH_TOKEN_LENGTH} characters" minlength="${HdlServer.MIN_AUTH_TOKEN_LENGTH}" aria-describedby="help_auth_key" value="${page.authToken}"/>
            </div>
            <p id="help_auth_key" class="help">The key every action call needs. If you change it, also change it in your IFTTT applets and anything else calling this server.</p>
        </div>
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="checkForUpdates" aria-describedby="help_updates" checked="${checkForUpdates}">
                Check for updates
            </label>
            <p id="help_updates" class="help">Once a day, asks GitHub for the latest version, and shows it on the Status page when there's a newer one.
                GitHub sees this server's IP address when it does.</p>
        </div>
        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="appPortOn" aria-describedby="help_app_port" checked="${appPortOn}">
                Let the Android app connect
            </label>
            <p id="help_app_port" class="help">Opens port ${appPort} for Smart Home for HDL Buspro, the Android app, with HTTPS
                and only from your home network or VPN.</p>
            @if(appPortProblem == AppPortProblem.PORT_TAKEN)
                <p class="help is-danger">Couldn't open port ${appPort}. Is something else using it? The log says more.</p>
            @elseif(appPortProblem == AppPortProblem.DATABASE_NOT_PRIVATE)
                <p class="help is-danger">Port ${appPort} stays closed: ${HdlServer.DATABASE_FILE} must be readable by its owner only,
                    since the port's private key would be kept there. Busbridge can't make it so on Windows yet, or when
                    another account owns the file.</p>
            @elseif(appFingerprint != null)
                <p class="help">Port ${appPort} is open. Its certificate's fingerprint, which the app checks:
                    <code class="fingerprint">${appFingerprint}</code></p>
            @endif
        </div>
        <button type="submit" class="button is-primary">Save</button>
    </form>
</div>
<div data-live="/settings/events">
    @template.live.phones(appPortOpen = appFingerprint != null, port = appPort, pairingOpen = pairingOpen, pairingView = pairingView, connecting = connecting, phones = phones, connected = connected)
</div>
`)
