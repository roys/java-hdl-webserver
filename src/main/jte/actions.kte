@import com.roysolberg.java.hdlserver.Icon
@import com.roysolberg.java.hdlserver.Operation
@import com.roysolberg.java.hdlserver.Page
@import com.roysolberg.java.hdlserver.hdl.Action
@import com.roysolberg.java.hdlserver.hdl.component.DimmerComponent
@import com.roysolberg.java.hdlserver.util.HdlUtil
@param page: Page
@template.layout(page = page, content = @`
<h1 class="title">Actions</h1>
@if(page.actions.isEmpty())
<div class="notification">No actions yet. Create your first one below.</div>
@endif
@for(action in page.actions)
!{val name = if (action.description.isNullOrEmpty()) "Action ${action.id}" else action.description}
<div class="card action-card">
    <header class="card-header">
        <div class="card-header-title">
            <div>
                <p>${name} <span class="tag is-rounded">${action.actionType.name}</span></p>
                @if(!action.aliases.isNullOrEmpty())
                <p class="has-text-grey is-size-7 has-text-weight-normal">Also: ${action.aliases.joinToString(", ")}</p>
                @endif
            </div>
        </div>
        <div class="action-buttons">
            @if(action.actionType == Action.ActionType.Dimmer)
            <form action="run_action" method="post">
                <input type="hidden" name="actionId" value="${action.id}"/>
                <div class="field has-addons">
                    <div class="control">
                        <input type="number" name="value" class="input level-input" min="0" max="100" value="50" aria-label="Level in percent" required/>
                    </div>
                    <div class="control"><span class="button is-static">%</span></div>
                    <div class="control"><button type="submit" class="button is-primary" title="Set the level now">Set</button></div>
                </div>
            </form>
            @else
            <button type="button" class="button is-primary" title="Run this action now" data-open="runActionModal-${action.id}">
                @template.icon(icon = Icon.Play)<span>Run</span>
            </button>
            @endif
            <button type="button" class="button" title="Delete action" aria-label="Delete action" data-open="deleteActionModal-${action.id}">
                @template.icon(icon = Icon.Delete)
            </button>
        </div>
    </header>
    <div class="card-content">
        <div class="table-container">
            <table class="table is-fullwidth is-narrow commands-table">
                <thead>
                <tr>
                    <th>Device</th>
                    <th>Operation</th>
                    <th><abbr title="Parameter 1">P1</abbr></th>
                    <th><abbr title="Parameter 2">P2</abbr></th>
                    <th><abbr title="Parameter 3">P3</abbr></th>
                </tr>
                </thead>
                <tbody>
                @for(command in action.commands)
                <tr>
                    <td class="is-family-monospace">${command.subnetId}/${command.deviceId}</td>
                    <td>${HdlUtil.getNiceOperationCode(command.operation)}</td>
                    <td>${command.parameter1?.toString()}</td>
                    <td>${command.parameter2?.toString()}</td>
                    <td>${command.parameter3?.toString()}</td>
                </tr>
                @endfor
                </tbody>
            </table>
        </div>
        <details class="how-to-call">
            <summary>How to call it</summary>
            <dl>
                <dt>URL</dt>
                <dd class="is-family-monospace">${action.getUrl(page.host)}</dd>
                <dt>cURL</dt>
                <dd><code>${action.getCurlCommand(page.host, page.authToken)}</code></dd>
                <dt>IFTTT</dt>
                @if(action.actionType == Action.ActionType.Dimmer)
                <dd>IFTTT's <a href="https://ifttt.com/google_assistant_v2" target="_blank" rel="noopener noreferrer">Google Assistant</a> can't pass on a level, so for voice, create a custom action for each level you want. Anything else that can send a web request can set any level, like the cURL command above: method <code>POST</code>, content type <code>application/json</code> and body <code>{"auth":"${page.authToken}","value":&lt;0-100&gt;}</code>.</dd>
                @else
                <dd>Use <a href="https://ifttt.com/google_assistant_v2" target="_blank" rel="noopener noreferrer">Google Assistant</a> <code>Activate scene</code>, and say <code>Hey Google, activate &lt;scene name&gt;</code>. Then use <a href="https://ifttt.com/maker_webhooks" target="_blank" rel="noopener noreferrer">Webhooks</a> (needs IFTTT Pro) <code>Make a web request</code> with URL <code>http://&lt;fill in your external host name or IP address and port number&gt;/api/actions/${action.id}</code>, method <code>POST</code>, content type <code>application/json</code> and body <code>{"auth":"${page.authToken}"}</code>. You need one applet for each custom action.</dd>
                @endif
            </dl>
        </details>
    </div>
</div>
@if(action.actionType != Action.ActionType.Dimmer)
<dialog id="runActionModal-${action.id}" class="box" aria-labelledby="runModalLabel-${action.id}">
    <form action="run_action" method="post">
        <input type="hidden" name="actionId" value="${action.id}"/>
        <p class="title is-5" id="runModalLabel-${action.id}">Run "${name}" now?</p>
        <p class="block">This sends its commands to the HDL bus right away.</p>
        <div class="buttons is-right">
            <button type="button" class="button" data-close>Cancel</button>
            <button type="submit" class="button is-primary">@template.icon(icon = Icon.Play)<span>Run</span></button>
        </div>
    </form>
</dialog>
@endif
<dialog id="deleteActionModal-${action.id}" class="box" aria-labelledby="deleteModalLabel-${action.id}">
    <form action="delete_action" method="post">
        <input type="hidden" name="actionId" value="${action.id}"/>
        <p class="title is-5" id="deleteModalLabel-${action.id}">Delete "${name}"?</p>
        <p class="block">IFTTT applets and anything else calling it will stop working.</p>
        <div class="buttons is-right">
            <button type="button" class="button" data-close>Cancel</button>
            <button type="submit" class="button is-danger">Delete</button>
        </div>
    </form>
</dialog>
@endfor

<h2 class="title is-4 create-heading">Create an action</h2>
<div class="columns">
    <div class="column">
        <div class="box">
            <h3 class="title is-5">Custom action</h3>
            <p class="subtitle is-6 has-text-grey">Commands of your choice, like a scene for <i>Movie night</i>, or a panel button for <i>Open the garage</i>.</p>
            <form action="create_custom_action" method="post">
                <div class="field">
                    <label class="label" for="input_description">Name</label>
                    <div class="control"><input type="text" name="description" class="input" id="input_description" placeholder="E.g. Open the garage"></div>
                </div>
                <p class="label">Commands</p>
                <div id="custom-commands" class="repeat-list">
                    <div class="repeat-row">
                        <button type="button" class="delete" aria-label="Remove this command" data-remove></button>
                        <div class="field">
                            <label class="label is-small">Device</label>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="components[]" aria-label="Device">
                                        @for(component in page.components)
                                        <option value="${component.subnet}:${component.deviceId}">${component.remark} (${component.subnet}/${component.deviceId} - ${component.description})</option>
                                        @endfor
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label is-small">Operation</label>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="operations[]" aria-label="Operation" data-operation>
                                        @for(operation in Operation.entries)
                                        <option value="${operation.code}" data-parameters="${operation.parameters.joinToString("|")}">${operation.title} (${operation.hex})</option>
                                        @endfor
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="columns is-mobile is-variable is-2 is-multiline">
                            @for(index in 1..3)
                            !{val parameter = Operation.entries.first().parameters[index - 1]}
                            <div class="column is-one-third-tablet is-half-mobile field" data-parameter="${index}" hidden="${parameter.isEmpty()}">
                                <label class="label is-small">${parameter.ifEmpty { "Parameter $index" }}</label>
                                <div class="control"><input list="parameters${index}" name="parameters${index}[]" min="0" max="255" type="number" class="input" placeholder="0-255" aria-label="${parameter.ifEmpty { "Parameter $index" }}"/></div>
                            </div>
                            @endfor
                        </div>
                    </div>
                </div>
                <datalist id="parameters1">
                    <option value="17">Panel control - control button status (17)</option>
                    <option value="18">Panel control - control button (18)</option>
                </datalist>
                <datalist id="parameters2">
                    <option value="0">Curtain switch control - stop (0)</option>
                    <option value="1">Curtain switch control - open/forward (1)</option>
                    <option value="2">Curtain switch control - close/reverse (2)</option>
                    <option value="255">Universal switch control - on (255)</option>
                </datalist>
                <datalist id="parameters3"></datalist>
                <div class="buttons">
                    <button type="button" class="button is-light" data-add="custom-commands">@template.icon(icon = Icon.Add)<span>Add a command</span></button>
                    <button type="submit" class="button is-primary">Create action</button>
                </div>
            </form>
        </div>
    </div>
    <div class="column">
        <div class="box">
            <h3 class="title is-5">Dimmer action</h3>
            <p class="subtitle is-6 has-text-grey">Sets the lights in an area to any level, like <i>the kitchen</i> to 20 %.</p>
            <form action="create_dimmer_action" method="post">
                <div class="field">
                    <label class="label" for="input_area_name">Area name</label>
                    <div class="control"><input type="text" name="description" class="input" id="input_area_name" placeholder="E.g. the kitchen"/></div>
                </div>
                <p class="label">Other names for the area</p>
                <div id="dimmer-aliases" class="repeat-list">
                    <div class="repeat-row is-compact">
                        <button type="button" class="delete" aria-label="Remove this name" data-remove></button>
                        <div class="control"><input type="text" name="aliases[]" class="input" placeholder="E.g. kitchen (without the)" aria-label="Other name for the area"/></div>
                    </div>
                </div>
                <div class="buttons">
                    <button type="button" class="button is-light" data-add="dimmer-aliases">@template.icon(icon = Icon.Add)<span>Add a name</span></button>
                </div>
                <p class="label">Dimmer channels</p>
                <div id="dimmer-channels" class="repeat-list">
                    <div class="repeat-row is-compact">
                        <button type="button" class="delete" aria-label="Remove this channel" data-remove></button>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select name="channels[]" aria-label="Dimmer channel">
                                    @for(component in page.components.filterIsInstance<DimmerComponent>())
                                    @for(index in 1..component.numOfChannels)
                                    <option value="${component.subnet}:${component.deviceId}:${index}">${component.remark} (${component.subnet}/${component.deviceId}) - channel ${index}</option>
                                    @endfor
                                    @endfor
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="buttons">
                    <button type="button" class="button is-light" data-add="dimmer-channels">@template.icon(icon = Icon.Add)<span>Add a channel</span></button>
                    <button type="submit" class="button is-primary">Create action</button>
                </div>
            </form>
        </div>
    </div>
</div>
`)
