@import com.roysolberg.java.hdlserver.Page
@import com.roysolberg.java.hdlserver.Status
@param page: Page
@param status: Status
@template.layout(page = page, content = @`
<style>
    .stat { padding: 18px 20px; margin-bottom: 20px; border: 1px solid #e3e3e3; border-radius: 6px; background: #fff; }
    .stat-label { color: #777; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
    .stat-value { font-size: 34px; font-weight: 300; line-height: 1.2; margin-top: 4px; }
    .stat-note { color: #999; font-size: 13px; }
    .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 8px; vertical-align: middle; }
    .dot-alive { background: #5cb85c; box-shadow: 0 0 0 4px rgba(92, 184, 92, .2); }
    .dot-silent { background: #d9534f; box-shadow: 0 0 0 4px rgba(217, 83, 79, .2); }
</style>
<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <h3>Status</h3>
        <div class="stat">
            <div class="stat-label">HDL bus</div>
            <div class="stat-value">
                <span class="dot ${if (status.busAlive) "dot-alive" else "dot-silent"}"></span>@if(status.busAlive)Alive@elseSilent@endif
            </div>
            <div class="stat-note">Last message ${status.lastBusMessageAgo} &middot; ${status.busMessagesLastHour} in the last hour &middot; ${status.busMessages} since the server started</div>
            <svg viewBox="0 0 ${Status.SPARKLINE_WIDTH} ${Status.SPARKLINE_HEIGHT}" preserveAspectRatio="none" style="width:100%;height:80px;display:block;margin-top:14px;"
                 role="img" aria-label="Messages on the HDL bus per minute, the last hour">
                <defs>
                    <linearGradient id="busFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#337ab7" stop-opacity=".35"/>
                        <stop offset="100%" stop-color="#337ab7" stop-opacity=".02"/>
                    </linearGradient>
                </defs>
                <polygon points="${status.sparklineArea}" fill="url(#busFill)"/>
                <polyline points="${status.sparklineLine}" fill="none" stroke="#337ab7" stroke-width="2" vector-effect="non-scaling-stroke"/>
            </svg>
            <div class="stat-note" style="display:flex;justify-content:space-between;"><span>1 hour ago</span><span>now</span></div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <div class="row">
            <div class="col-sm-3 col-xs-6">
                <div class="stat">
                    <div class="stat-label">Running for</div>
                    <div class="stat-value" style="font-size:22px;">${status.uptime}</div>
                    <div class="stat-note">Since ${Status.formatTime(status.startedAt)}</div>
                </div>
            </div>
            <div class="col-sm-3 col-xs-6">
                <div class="stat">
                    <div class="stat-label">Devices</div>
                    <div class="stat-value">${status.components}</div>
                    <div class="stat-note"><a href="/">See them</a></div>
                </div>
            </div>
            <div class="col-sm-3 col-xs-6">
                <div class="stat">
                    <div class="stat-label">Actions</div>
                    <div class="stat-value">${status.actions}</div>
                    <div class="stat-note"><a href="/actions">See them</a></div>
                </div>
            </div>
            <div class="col-sm-3 col-xs-6">
                <div class="stat">
                    <div class="stat-label">API calls today</div>
                    <div class="stat-value">${status.apiCallsToday}</div>
                    <div class="stat-note">
                        @if(status.lastApiCall != null)
                        Last ${Status.formatTime(status.lastApiCall.time).substring(11)}: ${status.lastApiCall.result}
                        @else
                        None since the server started
                        @endif
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-10 col-md-offset-1">
        <div class="stat">
            <div class="stat-label">Server</div>
            <table class="table table-condensed" style="margin:8px 0 0;">
                <tr><th style="width:30%;">Version</th><td>${status.version}</td></tr>
                <tr><th>Java</th><td>${status.javaVersion}</td></tr>
                <tr>
                    <th>Memory</th>
                    <td>
                        ${status.memoryUsedMb} of ${status.memoryMaxMb} MB
                        <div class="progress" style="height:6px;margin:6px 0 0;">
                            <div class="progress-bar" style="width:${(status.memoryUsedMb * 100 / status.memoryMaxMb.coerceAtLeast(1)).toString()}%;"></div>
                        </div>
                    </td>
                </tr>
                @if(status.cpuTemperature != null)
                <tr><th>CPU temperature</th><td>${String.format(java.util.Locale.ROOT, "%.0f", status.cpuTemperature)} &deg;C</td></tr>
                @endif
            </table>
        </div>
    </div>
</div>
`)
