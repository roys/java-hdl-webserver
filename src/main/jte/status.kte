@import com.roysolberg.java.hdlserver.Page
@import com.roysolberg.java.hdlserver.Status
@param page: Page
@param status: Status
@template.layout(page = page, content = @`
<div class="page-header">
    <h1 class="title">Status</h1>
    <span class="tag is-rounded live-tag" title="This page updates by itself">Live</span>
</div>
<div data-live="/status/events">
    @template.live.status(status = status)
</div>
`)
