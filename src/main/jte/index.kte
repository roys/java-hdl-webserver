@import com.roysolberg.java.hdlserver.Icon
@import com.roysolberg.java.hdlserver.Page
@param page: Page
@template.layout(page = page, content = @`
<div class="page-header">
    <h1 class="title">Components</h1>
    <form action="search_for_components" method="post">
        <button type="submit" class="button is-primary is-light">@template.icon(icon = Icon.Search)<span>Search again</span></button>
    </form>
</div>
<p class="subtitle is-6 has-text-grey">${page.components.size} modules answered the search on the HDL bus.</p>
<div class="table-container">
    <table class="table is-fullwidth is-hoverable is-striped">
        <thead>
        <tr>
            <th>Address</th>
            <th>Name</th>
            <th>Type</th>
        </tr>
        </thead>
        <tbody>
        @for(component in page.components)
        <tr>
            <td class="is-family-monospace">${component.subnet}/${component.deviceId}</td>
            <th>${component.remark}</th>
            <td>${component.description}</td>
        </tr>
        @endfor
        </tbody>
    </table>
</div>
`)
