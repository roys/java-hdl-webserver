@import com.roysolberg.java.hdlserver.HdlServer
@import com.roysolberg.java.hdlserver.Icon
@import com.roysolberg.java.hdlserver.Page
@import gg.jte.Content
@param page: Page
@param content: Content
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${page.title} · Busbridge</title>
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#00d1b2" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#006b5b" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="${HdlServer.ASSETS_PATH}/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="${HdlServer.ASSETS_PATH}/apple-touch-icon.png">
    <link rel="manifest" href="${HdlServer.ASSETS_PATH}/manifest.webmanifest">
    <link rel="stylesheet" href="${HdlServer.ASSETS_PATH}/vendor/bulma.min.css">
    <link rel="stylesheet" href="${HdlServer.ASSETS_PATH}/app.css">
    <script src="${HdlServer.ASSETS_PATH}/app.js" defer></script>
</head>
<body>
<nav class="navbar is-primary" aria-label="Main menu">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-item brand" href="/">
                @template.icon(icon = Icon.Home)
                <span>Busbridge</span>
            </a>
            <button type="button" class="navbar-burger" aria-label="Menu" aria-expanded="false" aria-controls="menu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>
        </div>
        <div id="menu" class="navbar-menu">
            <div class="navbar-start">
                @for(item in Page.MENU)
                <a class="navbar-item${if (item.name == page.name) " is-active" else ""}" href="${item.path}" aria-current="${if (item.name == page.name) "page" else null}">${item.title}</a>
                @endfor
            </div>
        </div>
    </div>
</nav>
<main class="section">
    <div class="container">
        @if(!page.successMessage.isNullOrEmpty())
        <div class="notification is-success is-light" role="status">
            <button type="button" class="delete" aria-label="Close"></button>
            ${page.successMessage}
        </div>
        @endif
        @if(!page.errorMessage.isNullOrEmpty())
        <div class="notification is-danger is-light" role="alert">
            <button type="button" class="delete" aria-label="Close"></button>
            ${page.errorMessage}
        </div>
        @endif
        ${content}
    </div>
</main>
<footer class="page-footer has-text-grey is-size-7">
    <div class="container">
        <p class="app-link">📱 To control your HDL devices from your phone, there's also <a href="https://play.google.com/store/apps/details?id=com.roysolberg.android.smarthome" target="_blank" rel="noopener noreferrer">Smart Home for HDL Buspro</a>, an app for Android.</p>
        <p>Independent project, not affiliated with or endorsed by HDL Automation. HDL, Buspro and other trademarks belong to their owners.</p>
    </div>
</footer>
</body>
</html>
